APP_ENV=development
FRONTEND_URL=http://localhost:5174
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/trex_sms
REDIS_URL=redis://localhost:6379/1

AUTH_JWKS_URL=http://localhost:8000/.well-known/jwks.json
AUTH_ISSUER=t-rex
AUTH_AUDIENCE=t-rex-engines
ALLOW_DEMO_IDENTITY=true

TPI_API_BASE_URL=http://localhost:8001
TPI_INTERNAL_SERVICE_TOKEN=
SMS_INTERNAL_SERVICE_TOKEN=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.25
GROQ_MAX_COMPLETION_TOKENS=1024

DEFAULT_TIMEZONE=America/New_York
QUIET_HOURS_START=20
QUIET_HOURS_END=8
MAX_AGENT_TURNS=8
