# T Rex Idea Engine — Environment Configuration
# Copy to `.env` and fill in your values:  cp .env.example .env
#
# All teammates share one Supabase database. Only DATABASE_URL is hard-required.
# TPI (LLM summaries) is optional — the report pipeline degrades to
# deterministic summaries when it is not configured.

APP_ENV=development

# Database (Shared Supabase / PostgreSQL)
# Use the connection from supabase credentials.txt. Any psycopg/vanilla driver
# is normalized to postgresql+asyncpg and credentials are URL-encoded by config.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Redis (internal compose service; used only when the scheduler profile runs)
REDIS_URL=redis://redis:6379/0

# Optional TPI LLM synthesis. Leave empty to use deterministic summaries.
# Point at a shared/deployed TPI if one exists, e.g. http://host:8001
TPI_API_BASE_URL=
TPI_INTERNAL_SERVICE_TOKEN=

# Idea Engine Storage & Scheduling (runs at exactly 00:00 UTC for the previous day)
REPORTS_STORAGE_DIR=/app/storage/reports
REPORT_RUN_CRON=0 0 * * *

# Ports
FRONTEND_PORT=5176
BACKEND_PORT=8006

# CORS (only relevant when the UI talks to the API cross-origin; the bundled
# nginx setup proxies /idea same-origin, so this is a safety net)
FRONTEND_ORIGINS=http://localhost:5176,http://localhost:5173,http://localhost:5174,http://localhost:5175