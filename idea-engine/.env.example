# T Rex Idea Engine — Environment Configuration
APP_ENV=development

# Database (Shared Supabase / PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Redis (Shared or local for Celery daily scheduled report runs)
REDIS_URL=redis://localhost:6379/0

# Shared TPI Engine Base URL (Internal)
TPI_API_BASE_URL=http://localhost:8001

# Idea Engine Storage & Scheduling
REPORTS_STORAGE_DIR=storage/reports
REPORT_RUN_CRON=59 23 * * *

# Ports
FRONTEND_PORT=5176
BACKEND_PORT=8006
FRONTEND_ORIGINS=http://localhost:5176,http://localhost:5173
