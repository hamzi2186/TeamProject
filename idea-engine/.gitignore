# Storage and Database
storage/*.db
storage/*.sqlite
storage/*.sqlite3
backend/storage/*.db
backend/storage/*.sqlite
backend/storage/*.sqlite3

# Generated reports storage (keep .gitkeep only)
storage/reports/*.docx
backend/storage/reports/*.docx
*.docx
!storage/reports/.gitkeep
!backend/storage/reports/.gitkeep

# Environment & Secrets
.env
.env.*
**/.env
**/.env.*
!**/.env.example
*credentials*.txt
*.secret

# Logs
*.log
logs/
