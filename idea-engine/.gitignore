# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Node / Frontend
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
