APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trex
TPI_API_BASE_URL=http://localhost:8001
TPI_INTERNAL_SERVICE_TOKEN=
AUTH_JWKS_URL=http://localhost:8000/.well-known/jwks.json
AUTH_AUDIENCE=trex-api
AUTH_ISSUER=trex-auth
AUTH_JWT_ALGORITHM=RS256
DOCS_ROOT_PATH=../../docs/agent-knowledge
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSION=1024
DEFAULT_SIMILARITY_THRESHOLD=0.5

