APP_ENV=development
FRONTEND_URL=http://localhost:5173
TPI_INTERNAL_SERVICE_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=T Rex
SMTP_USE_TLS=true

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
HUBSPOT_SCOPES=crm.objects.contacts.read
HUBSPOT_TOKEN_ENCRYPTION_KEY=

# Embeddings
EMBEDDING_PROVIDER=jina
EMBEDDING_FALLBACK_PROVIDER=
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSION=1024
LOCAL_EMBEDDING_MODEL=trex-local-hash-v1
LOCAL_EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
AGENT_JINA_API_KEY=
AGENT_JINA_EMBEDDING_MODEL=jina-embeddings-v3
AGENT_JINA_EMBEDDING_DIMENSION=1024

# SMS / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER_ROUTES=[]
TWILIO_DEFAULT_USER_ID=
TWILIO_DEFAULT_SMS_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
PUBLIC_WEBHOOK_BASE_URL=
SMS_ENGINE_INTERNAL_BASE_URL=http://sms-backend:8004
SMS_INTERNAL_SERVICE_TOKEN=
SMS_PROVIDER=twilio
MOCK_SMS_FROM_NUMBER=+15555550100

# LLM / Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
