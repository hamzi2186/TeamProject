# Root compose uses service-specific environment files.
# Copy examples only when creating a new local setup; never overwrite existing .env files.
COMPOSE_PROJECT_NAME=trex
SCRAPER_INTERNAL_SERVICE_TOKEN=

# SMS Engine DB (used by docker-compose.yml)
SMS_DB_USER=sms
SMS_DB_PASSWORD=sms
SMS_DB_NAME=trex_sms

# SMS provider: twilio | mock
SMS_PROVIDER=mock

# Crawl limit for scraper worker
CRAWL_MAX_PAGES=100
